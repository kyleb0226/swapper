# Copy to your hosting provider's environment settings. Never commit real values.

# Required in production
SECRET_KEY_BASE=            # generate with: bin/rails secret
APP_HOST=app.yourdomain.com # used for email links and host protection

# Email. Option A (free, good to start): your Gmail account.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below (NOT your normal password).
#   Gmail allows roughly 500 emails/day; keep OUTREACH_DAILY_LIMIT well under that.
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=abcdabcdabcdabcd
#
# Option B (once you have customers): a sending service such as Postmark,
# SendGrid, Amazon SES or Resend. Replace the four lines above with theirs, e.g.
#   SMTP_ADDRESS=smtp.postmarkapp.com  SMTP_USERNAME=<api token>  SMTP_PASSWORD=<api token>
MAIL_FROM="Swapper <you@gmail.com>"   # with Gmail, must be your Gmail address
CONTACT_EMAIL=you@yourdomain.com

# Run background jobs (emails) inside the web process on a single server
SOLID_QUEUE_IN_PUMA=1

# Owner outreach tool
OUTREACH_FROM="Kyle at Swapper <you@gmail.com>"
OUTREACH_POSTAL_ADDRESS="123 Main St, City, ST 00000"  # required by CAN-SPAM
OUTREACH_DAILY_LIMIT=50

# AI agent access (see docs/outreach-agent/). Generate a token with: bin/rails secret
OUTREACH_API_TOKEN=
# 0 = agents can research and add prospects, you send from /admin (recommended to start)
# 1 = agents can also send emails (same safety rules and daily limit apply)
OUTREACH_API_ALLOW_SEND=0

# AI job matching (optional). Lets companies match employees in similar but
# differently named jobs. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5. claude-sonnet-5-5 costs about half as much.
SWAPPER_AI_MODEL=
