<% content_for :title, "Custom matching for your organization" %>
<div class="row g-4 justify-content-center py-3">
  <div class="col-lg-5"><%= render "pitch" %></div>
  <div class="col-lg-6">
    <div class="card shadow-sm"><div class="card-body p-4">
      <% if params[:sent] %>
        <h2 class="h5">Thanks — request received.</h2>
        <p class="mb-0 text-body-secondary">We'll email you within one business day to talk through what you need.</p>
      <% else %>
        <%= render "form", custom_request: @custom_request %>
      <% end %>
    </div></div>
  </div>
</div>
