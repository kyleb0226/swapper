<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [ content_for(:title), "Swapper" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Swapper matches employees who want to trade work locations, so HR can approve fair, seniority-based transfers in minutes.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "bootstrap.min" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "bootstrap.bundle.min", defer: true %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render "shared/navbar" %>
    <main class="container py-4 flex-grow-1">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
