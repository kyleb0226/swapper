<%= page_title "Activity log", "Every change to employees, matches, locations and access." %>
<div class="table-responsive">
  <table class="table table-sm bg-white border">
    <thead class="table-dark"><tr><th>When</th><th>Who</th><th>What</th></tr></thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td class="text-nowrap small"><%= l(event.created_at, format: :short) %></td>
          <td class="small"><%= event.user&.display_name || "System" %></td>
          <td><%= event.summary || event.action %> <span class="text-body-secondary small">(<%= event.action %>)</span></td>
        </tr>
      <% end %>
      <% if @events.empty? %><tr><td colspan="3" class="text-center text-body-secondary py-4">Nothing yet.</td></tr><% end %>
    </tbody>
  </table>
</div>
<div class="d-flex gap-2">
  <% if @page > 1 %><%= link_to "← Newer", activity_path(page: @page - 1), class: "btn btn-sm btn-outline-secondary" %><% end %>
  <% if @next_page %><%= link_to "Older →", activity_path(page: @page + 1), class: "btn btn-sm btn-outline-secondary" %><% end %>
</div>
