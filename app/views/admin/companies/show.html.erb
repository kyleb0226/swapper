<%= page_title @company.name, "Created #{l(@company.created_at.to_date, format: :long)}" %>
<div class="row g-4">
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
      <dl class="row mb-0">
        <dt class="col-7">Locations</dt><dd class="col-5"><%= @company.locations.count %></dd>
        <dt class="col-7">Employees</dt><dd class="col-5"><%= @company.employees.count %></dd>
        <% Match::STATUSES.each do |status| %>
          <dt class="col-7"><%= status.humanize %> matches</dt><dd class="col-5"><%= @match_counts.fetch(status, 0) %></dd>
        <% end %>
      </dl>
    </div></div>
    <div class="card mt-3"><div class="card-body">
      <h2 class="h6">Matching rules</h2>
      <% described = @company.rules.describe %>
      <ul class="small mb-3"><% described.each do |line| %><li><%= line %></li><% end %><% if described.empty? %><li class="text-body-secondary">Standard matching only</li><% end %></ul>
      <%= form_with model: @company, url: admin_company_path(@company), method: :patch do |form| %>
        <%= form.label :custom_rule, "Custom rule for this customer", class: "form-label small" %>
        <% options = MatchRules::Custom.all.map { |k| [ k.label, k.key ] } %>
        <%= form.select :custom_rule, options, { include_blank: "None" }, class: "form-select form-select-sm mb-2", disabled: options.empty? %>
        <% if options.empty? %>
          <div class="form-text mb-2">No custom rules built yet. Add one in <code>app/services/match_rules/custom/</code> (see <code>docs/CUSTOM_RULES.md</code>).</div>
        <% else %>
          <%= form.submit "Save & re-run matching", class: "btn btn-sm btn-primary" %>
        <% end %>
      <% end %>
    </div></div>
  </div>
  <div class="col-lg-8">
    <div class="table-responsive">
      <table class="table bg-white border">
        <thead class="table-dark"><tr><th>User</th><th>Role</th><th>Status</th><th>Last sign in</th></tr></thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.display_name %><br><span class="small"><%= mail_to user.email %></span></td>
              <td><%= user.role_label %></td>
              <td><%= status_badge(user.pending_invitation? ? "invited" : "active") %></td>
              <td class="small"><%= user.last_sign_in_at ? "#{time_ago_in_words(user.last_sign_in_at)} ago" : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
