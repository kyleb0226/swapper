<%= page_title "Invite someone" %>
<div class="card" style="max-width: 40rem"><div class="card-body p-4">
  <%= form_with model: @member, url: team_members_path do |form| %>
    <%= render "shared/errors", record: @member %>
    <div class="mb-3">
      <%= form.label :email, class: "form-label" %>
      <%= form.email_field :email, class: "form-control", required: true %>
      <div class="form-text">If an employee already has this email, their profile is linked automatically.</div>
    </div>
    <div class="mb-3">
      <%= form.label :name, class: "form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>
    <%= render "role_field", form: form %>
    <%= form.submit "Send invitation", class: "btn btn-primary" %>
    <%= link_to "Cancel", team_members_path, class: "btn btn-link" %>
  <% end %>
</div></div>
