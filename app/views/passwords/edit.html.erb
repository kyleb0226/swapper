<% content_for :title, "Account settings" %>
<div class="row justify-content-center">
  <div class="col-md-7 col-lg-6">
    <%= page_title "Account settings", Current.user.email %>
    <div class="card"><div class="card-body p-4">
      <%= form_with model: (@user || Current.user), url: password_path, method: :patch do |form| %>
        <%= render "shared/errors", record: (@user || Current.user) %>
        <div class="mb-3">
          <%= form.label :name, class: "form-label" %>
          <%= form.text_field :name, class: "form-control" %>
        </div>
        <div class="row">
          <div class="col-sm-6 mb-3">
            <%= form.label :password, "New password", class: "form-label" %>
            <%= form.password_field :password, class: "form-control", minlength: 8, autocomplete: "new-password" %>
            <div class="form-text">Leave blank to keep your current password.</div>
          </div>
          <div class="col-sm-6 mb-3">
            <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
            <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
          </div>
        </div>
        <div class="mb-3">
          <%= form.label :current_password, class: "form-label" %>
          <%= form.password_field :current_password, class: "form-control", required: true, autocomplete: "current-password" %>
        </div>
        <%= form.submit "Save changes", class: "btn btn-primary" %>
      <% end %>
    </div></div>
  </div>
</div>
