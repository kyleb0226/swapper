<% content_for :title, "Sign in" %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm"><div class="card-body p-4">
      <h1 class="h4 mb-4">Sign in</h1>
      <%= form_with url: sign_in_path do |form| %>
        <div class="mb-3">
          <%= form.label :email, class: "form-label" %>
          <%= form.email_field :email, value: params[:email], class: "form-control", required: true, autofocus: true, autocomplete: "username" %>
        </div>
        <div class="mb-3">
          <div class="d-flex justify-content-between">
            <%= form.label :password, class: "form-label" %>
            <%= link_to "Forgot password?", new_password_reset_path, class: "small" %>
          </div>
          <%= form.password_field :password, class: "form-control", required: true, autocomplete: "current-password" %>
        </div>
        <%= form.submit "Sign in", class: "btn btn-primary w-100" %>
      <% end %>
      <p class="small text-body-secondary mt-4 mb-0">
        New company? <%= link_to "Create a workspace", sign_up_path %>.
        Employees: use the invitation link your HR team emailed you.
      </p>
    </div></div>
  </div>
</div>
