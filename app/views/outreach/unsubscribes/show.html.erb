<% content_for :title, "Unsubscribe" %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card"><div class="card-body p-4 text-center">
      <% if @prospect.nil? %>
        <h1 class="h4">Link not recognized</h1>
        <p class="mb-0 text-body-secondary">This unsubscribe link is invalid. Reply to the email and we'll remove you by hand.</p>
      <% elsif @prospect.unsubscribed? %>
        <h1 class="h4">You're unsubscribed</h1>
        <p class="mb-0 text-body-secondary"><%= @prospect.email %> won't receive any more emails from us.</p>
      <% else %>
        <h1 class="h4">Unsubscribe?</h1>
        <p class="text-body-secondary">Stop all emails from Swapper to <%= @prospect.email %>.</p>
        <%= button_to "Unsubscribe", outreach_unsubscribe_path(params[:token]), class: "btn btn-primary" %>
      <% end %>
    </div></div>
  </div>
</div>
